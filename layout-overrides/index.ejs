<%
    var experience = theme.experience || {};
    var home = experience.home || {};
    var visiblePosts = site.posts.data
        .filter(function (post) { return !post.hide; })
        .slice()
        .sort(function (a, b) { return b.date - a.date; });
    var recentCount = Math.max(1, Number(home.recentCount || 5));
    var recentPosts = visiblePosts.slice(0, recentCount);

%>

<div class="post-main home-content" data-pagefind-ignore>
    <section class="home-section" aria-labelledby="recent-posts-title">
        <div class="section-heading">
            <h2 id="recent-posts-title">最近文章</h2>
            <a href="<%- url_for('/list/') %>">全部文章 <span aria-hidden="true">→</span></a>
        </div>
        <% if(recentPosts.length) { %>
            <ol class="recent-post-list">
                <% recentPosts.forEach(function (post) { %>
                    <li>
                        <%- partial('_partial/post-card', { post: post }) %>
                    </li>
                <% }); %>
            </ol>
        <% } else { %>
            <p>更多文章正在整理中。</p>
        <% } %>
    </section>
</div>
