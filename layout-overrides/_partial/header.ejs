<%- partial('_partial/post-header') %>
<section class="home-hero" aria-label="首页诗句">
    <% if(theme.index.header != null || theme.index.header == "") { %>
        <div class="index-header-line" aria-live="polite">
            <% if(theme.index.hitokoto) { %>
                <span id="quote"></span>
                <script src="<%= url_for('/js/hitokoto.js') %>"></script>
            <% } else { %>
                <div id="hiddenHeaderContentArray" hidden>
                    <% for(let i = 0; i < theme.index.header.length; i++) { %>
                        <span><%= theme.index.header[i] %></span>
                    <% } %>
                </div>
                <span id="targetSpan"></span>
            <% } %>
        </div>
    <% } %>

</section>
