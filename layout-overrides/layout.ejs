<!DOCTYPE html>
<html lang="<%= config.language || 'en' %>">
    <%- partial('_partial/configcss/font') %>
    <%- partial('_partial/head') %>
    <%- partial('_partial/configcss/width') %>
    <%- partial('_partial/configcss/color') %>
    <%- partial('_partial/configcss/imageShow') %>

    <body>
        <a class="skip-link" href="#main-content">跳到正文</a>
        <% if(theme.tool.darkMode) { %>
        <script>
        (function () {
            // darkreader.min.js（88K）按需加载：浅色模式用户完全不下载
            const drOptions = {
                brightness: 100,
                contrast: 95,
                sepia: 10,
                darkSchemeTextColor: '#e0e0e0',  // 粉笔白文字
                darkSchemeBackgroundColor: '#1e1e1e', // 黑板灰背景
                scrollbarStyle: 'native'
            };

            let loading = null;
            function loadDarkReader() {
                if (window.DarkReader) return Promise.resolve();
                if (!loading) {
                    loading = new Promise((resolve, reject) => {
                        const script = document.createElement('script');
                        script.src = '/js/darkreader.min.js';
                        script.onload = resolve;
                        script.onerror = reject;
                        document.head.appendChild(script);
                    });
                }
                return loading;
            }

            function enableDark() {
                document.documentElement.style.backgroundColor = '#1e1e1e';
                document.documentElement.style.colorScheme = 'dark';
                return loadDarkReader().then(() => DarkReader.enable(drOptions));
            }

            function disableDark() {
                document.documentElement.style.backgroundColor = '';
                document.documentElement.style.colorScheme = '';
                if (window.DarkReader) DarkReader.disable();
            }

            const savedTheme = localStorage.getItem('theme');
            const systemDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
            const startDark = savedTheme === 'dark' || (!savedTheme && systemDark);
            if (startDark) enableDark();

            window.addEventListener('DOMContentLoaded', () => {
                const btn = document.createElement('button');
                btn.innerText = '🌓';
                btn.type = 'button';
                btn.setAttribute('aria-label', '切换深色模式');
                btn.title = '切换深色模式';
                // 按钮样式：仿照你之前的布局，放在右下角
                btn.style.cssText = `
                    position: fixed; 
                    bottom: 40px; 
                    left: 42px; 
                    z-index: 9999;
                    width: 44px; 
                    height: 44px; 
                    border-radius: 50%; 
                    border: 1px solid #ccc;
                    background: #f7f5ed; 
                    color: #000;
                    font-size: 22px; 
                    cursor: pointer;
                    box-shadow: 0 4px 10px rgba(0,0,0,0.1); 
                    transition: transform 0.2s, background-color 0.3s;
                `;
                let isDark = startDark;
                function paintButton() {
                    btn.style.backgroundColor = isDark ? '#1e1e1e' : '#f7f5ed';
                    btn.style.color = isDark ? '#fff' : '#000';
                }
                paintButton();
                btn.onmouseover = () => btn.style.transform = 'scale(1.1)';
                btn.onmouseout = () => btn.style.transform = 'scale(1)';
                document.body.appendChild(btn);
                // 点击切换逻辑
                btn.addEventListener('click', () => {
                    isDark = !isDark;
                    if (isDark) {
                        enableDark();
                        localStorage.setItem('theme', 'dark');
                    } else {
                        disableDark();
                        localStorage.setItem('theme', 'light');
                    }
                    paintButton();
                });
            });
        })();
        </script>
        <% } %>
        <% if(theme.tool.leftToc) { %>
            <% if(is_post() && (!('leftToc' in page) || page.leftToc == true)) { %>
                <div class="left-toc-container">
                    <nav id="toc" class="bs-docs-sidebar"></nav>
                </div>
            <% } %>
        <% } %>
        <main id="main-content" class="paper" tabindex="-1">

            <% var tags,tagsInside, categories, categoriesInside; %>

            <% if(path == "index.html") { %>
                <div class="shadow-drop-2-bottom index-main">
                    <%- partial('_partial/header') %>
                    <%- partial('index') %>
                    <% if(theme.index.list) { %>
                        <%- partial('list') %>
                    <% } %>
                    <%- partial('_partial/footer') %>
                </div>
            <% } else if(path == "list/index.html") { %>
                <div class="shadow-drop-2-top paper-main">
                     <%- partial('_partial/post-header') %>
                     <%- partial('list') %>
                     <%- partial('_partial/footer') %>
                </div>
            <% } else if(path == "404.html") { %>
                <div class="shadow-drop-2-top paper-main">
                    <%- partial('_partial/404-template') %>
                    <%- partial('_partial/footer') %>
                </div>
            <% } else if(path == "recent-updates/index.html") { %>
                <div class="shadow-drop-2-top paper-main">
                    <%- partial('_partial/post-header') %>
                    <%- partial('_partial/recent-updates') %>
                    <%- partial('_partial/footer') %>
               </div>
            <% } else { %>
                <div class="shadow-drop-2-bottom paper-main">
                    <%- partial('_partial/post-header') %>

                    <% if(tags = (path == "tags/index.html")) { %>
                            <%- partial('tags') %>
                    <% } %>
                    <% if(categories = (path == "categories/index.html")) { %>
                            <%- partial('categories') %>
                    <% } %>

                    <% if(tagsInside = (path.length > "tags/index.html".length && path.substring(0, 5) == "tags/")) { %>
                            <%- partial('_partial/tags-list') %>
                    <% } %>
                    <% if(categoriesInside = (path.length > "categories/index.html".length && path.substring(0, 11) == "categories/")) { %>
                        <%- partial('_partial/categories-list') %>
                    <% } %>

                    <!--说明是文章post页面-->
                    <% if (!tags && !categories && !tagsInside && !categoriesInside) { %>
                        <%- partial('post') %>

                    <% } %>

                    <%- partial('_partial/footer') %>
                </div>
            <% } %>
            <% if(theme.tool.returnToTop) { %>
                <!-- 回到顶部的按钮-->
                <button class="progress-wrap shadow-drop-2-bottom" type="button" aria-label="回到页面顶部">
                    <svg class="progress-circle svg-content" width="100%" height="100%" viewBox="-1 -1 102 102">
                        <path d="M50,1 a49,49 0 0,1 0,98 a49,49 0 0,1 0,-98"/>
                    </svg>
                </button>
            <% } %>
            <% if(theme.tool.returnToLast) { %>
                <!-- 返回的按钮-->
                <button class="return-to-last-progress-wrap shadow-drop-2-bottom" type="button" aria-label="返回上一页">
                    <svg class="progress-circle svg-content" width="100%" height="100%" viewBox="-1 -1 102 102">
                        <path d="M50,1 a49,49 0 0,1 0,98 a49,49 0 0,1 0,-98"/>
                    </svg>
                </button>
            <% } %>
        </main>
    </body>
</html>
<script src="<%= url_for('/js/emojiHandler.js') %>"></script>
<script>
    document.addEventListener('DOMContentLoaded', () => {
        wrapEmojis('.paper');
    });
</script>
